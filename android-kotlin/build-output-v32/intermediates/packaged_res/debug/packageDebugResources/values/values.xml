    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F3F5</item>
        <item name="android:navigationBarColor">#F3F3F5</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="QuickExpenseTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@style/QuickExpenseWindowAnimation</item>
        <item name="android:colorAccent">#35C96F</item>
    </style>
    <style name="QuickExpenseWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/quick_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/quick_sheet_exit</item>
    </style>
    <style name="ShortcutTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.PainelURE" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
